# .env.example – copy this to .env and fill in your own values

# --- Application ---
APPLICATION_SERVER_PORT=8080
APPLICATION_SWAGGER_ENABLED=false

# --- Database ---
APPLICATION_DATABASE_HOST=localhost
APPLICATION_DATABASE_PORT=5432
APPLICATION_DATABASE_NAME=blog-db
APPLICATION_DATABASE_USERNAME=your_db_user
APPLICATION_DATABASE_PASSWORD=your_db_password

# --- Security ---
APPLICATION_SECURITY_SECRET=your-base64-encoded-secret
APPLICATION_SECURITY_ACCESS_TOKEN_LIFE_TIME=15m
APPLICATION_SECURITY_REFRESH_TOKEN_LIFE_TIME=14d
APPLICATION_SECURITY_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:8080

# --- Storage (S3/MinIO/SeaweedFS) ---
APPLICATION_STORAGE_MAX_FILE_SIZE=5MB
APPLICATION_STORAGE_MAX_REQUEST_SIZE=10MB
APPLICATION_STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp
APPLICATION_STORAGE_ENDPOINT=http://localhost:8333
APPLICATION_STORAGE_ACCESS_KEY=your_storage_access_key
APPLICATION_STORAGE_SECRET_KEY=your_storage_secret_key
APPLICATION_STORAGE_BUCKET=storage
APPLICATION_STORAGE_REGION=us-east-1

# --- Reserved Handles ---
APPLICATION_HANDLE_RESERVED_HANDLES=admin,root,system,api

# --- RabbitMQ ---
APPLICATION_RABBIT_MQ_HOST=localhost
APPLICATION_RABBIT_MQ_PORT=5672
APPLICATION_RABBIT_MQ_CLIENT_PORT=15672
APPLICATION_RABBIT_MQ_PROMETHEUS_PORT=15692
APPLICATION_RABBIT_MQ_USERNAME=your_rabbitmq_user
APPLICATION_RABBIT_MQ_PASSWORD=your_rabbitmq_password

# --- Redis ---
APPLICATION_REDIS_HOST=localhost
APPLICATION_REDIS_PORT=6379
APPLICATION_REDIS_PASSWORD=your_redis_password

# --- Mail (Mailpit for local testing) ---
APPLICATION_MAIL_HOST=localhost
APPLICATION_MAIL_PORT=1025
APPLICATION_MAIL_CLIENT_PORT=8025
APPLICATION_MAIL_FROM=noreply@yourdomain.com

# --- Verification Reminder TTL ---
APPLICATION_VERIFICATION_REMINDER_TTL=30s

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_USERS_PROFILE_URL=/users
FRONTEND_POSTS_DETAIL_URL=/posts

# --- Monitoring ---
MONITORING_PROMETHEUS_PORT=9090
MONITORING_GRAFANA_CLIENT_PORT=3000
MONITORING_GRAFANA_USER=admin
MONITORING_GRAFANA_PASSWORD=your_grafana_password